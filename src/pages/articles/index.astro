---

import   BaseLayout               from '../../layouts/BaseLayout.astro'
import { PortableText }           from 'astro-portabletext'
import { sanityClient, urlFor }   from '../../lib/sanity'
import { portableTextComponents } from '../../lib/portableTextComponents'
import   pullquote                from '../../components/pullquote.astro'
import { formatDate }             from '../../lib/utils'

const query = `*[_type == "post" && !(_id in path("drafts.**"))] | order(publishedAt desc) {
  title,
  "slug": slug.current,
  abstract,
  publishedAt,
  mainImage {
    asset,
    alt,
    caption
  },
  "author": author->{ name, image, bio, url },
  "categories": categories[]->{ _id, title }
}`

const articles = await sanityClient.fetch(query)

// TODO pull first article out to be treated as a featured article

---

<BaseLayout
  title={`Articles – Mad Egg Labs`}
>
  <section>
    {articles.length > 0 ? (
      articles.map((article) => (
        <article class="card">
          {article.mainImage && (
            <figure>
              <img
                src={article.mainImage.asset.url}
                alt={article.mainImage.alt || article.title}
              />
            </figure>
          )}
          <h2>
            <a href={`/articles/${article.slug}`}>{article.title}</a>
          </h2>
          {article.publishedAt && (
            <time datetime={article.publishedAt}>
              {formatDate(article.publishedAt)}
            </time>
          )}
          <p>{article.abstract}</p>
          {article.categories?.length > 0 && (
            <ul class="categories">
              {article.categories.map((cat) => (
                <li>{cat.title}</li>
              ))}
            </ul>
          )}
        </article>
      ))
    ) : (
      <div class="empty-state">
        <h2>No articles found</h2>
        <p>Check back later for new posts!</p>
      </div>
    )}
  </section>
</BaseLayout>
