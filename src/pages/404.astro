---

import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout
  title="Page Not Found – Mad Egg Labs"
  description="Sorry, the page you are looking for does not exist."
>
  <section class="error-page">
    <h2>Page Not Found</h2>
    <figure>
      <a href="https://http.cat/status/404"><img src="/assets/img/404.jpg" alt="404 not found"></a>
      <figcaption>Helpful image courtesy of <a href="https://http.cat/">HTTP Cats</a></figcaption>
    </figure>
    <p>Hmm, the page you’re looking for doesn’t exist, has been moved, or went missing.</p>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/articles/">Articles</a></li>
      <li><a href="/apps/">Apps</a></li>
    </ul>
  </section>
</BaseLayout>