---

import   BaseLayout               from '../../../../layouts/BaseLayout.astro'
import { PortableText }           from 'astro-portabletext'
import   faqblock                 from '../../../../components/faqblock.astro'
import { sanityClient }           from '../../../../lib/sanity'
import { portableTextComponents } from '../../../../lib/portableTextComponents'

const query = `*[_type == "page" && slug.current == "support"][0]{
  title,
  slug,
  body
}`

const page = await sanityClient.fetch(query)

---

<BaseLayout
  title={`Support – Is It Yacht Rock? – Mad Egg Labs`}
  description={`Is It Yacht Rock? is an iOS app by Mad Egg Labs that tells you whether a song is yacht rock. Mad Egg Labs provides software development and consulting services including iOS app development.`}
  image={`https://madegglabs.com/assets/img/social-iiyr.jpg`}
  ogTitle={`Is It Yacht Rock? by Mad Egg Labs`}
  bodyClasses={`iiyr`}
>
  <section>
    <h2><a href="../">Is It Yacht Rock?</a> – Support</h2>
    <div role="search">
      <label>
        Filter the FAQs by typing something into the search box.<br>
        <input type="search" placeholder="yachtski">
      </label>
    </div>
    <PortableText value={page.body} components={portableTextComponents} />
    <p>Have a question that’s not answered here? Email us at <span class="email-link" data-user="support"></span>.</p>
  </section>
</BaseLayout>
