---

import { urlFor } from '../lib/sanity'

const { node } = Astro.props

const imageUrl = node?.asset ? urlFor(node).url() : null
const altText = node?.alt || ''
const caption = node?.caption

---
{imageUrl && (
  <figure>
    <img
      src={imageUrl}
      alt={altText}
      loading="lazy"
    />
    {caption && (
      <figcaption>
        {caption}
      </figcaption>
    )}
  </figure>
)}
