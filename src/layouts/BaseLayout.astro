---

const {
  title        = 'Mad Egg Labs',
  description  = 'Even the smallest business deserves a fast, accessible website. If yours doesn’t delight, maybe we can help? Based in Portland, serving the world wide web.',
  image        = 'https://madegglabs.com/assets/img/social.jpg',
  canonicalUrl = Astro.url.href,
  ogTitle      = 'Mad Egg Labs',
  ogType       = 'website',
  bodyClasses  = '',
  status       = undefined
} = Astro.props

---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#19181d">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/x-icon" href="/favicon.png">
    <link rel="icon" type="image/png" href="/favicon.png" sizes="128x128">
    <link rel="apple-touch-icon" sizes="128x128" href="/favicon.png">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:type" content={ogType}>
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={image}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bahianita:wght@400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/styles.css">
    <script async src="https://cdn.seline.com/seline.js" data-token="43939c04f99b3c2" data-outbound="true"></script>
    <script type="module" src="/assets/index.js"></script>
  </head>
  <body class={bodyClasses || undefined}>
    <site-header data-status={status}></site-header>
    <main>
      <slot />
    </main>
    <site-footer></site-footer>
  </body>
</html>
