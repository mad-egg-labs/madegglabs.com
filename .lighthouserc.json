{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/articles/",
        "http://localhost:4321/articles/you-deserve-a-great-website/",
        "http://localhost:4321/articles/dont-make-your-customers-work/",
        "http://localhost:4321/apps/is-it-yacht-rock/",
        "http://localhost:4321/apps/is-it-yacht-rock/support/",
        "http://localhost:4321/privacy/",
        "http://localhost:4321/404"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
